<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Career Future — ATS Blocked</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <style>
    .nav-bar { display: flex; gap: 8px; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .nav-bar a { font-size: 0.85rem; padding: 0.4rem 0.8rem; }
    .platform-section { margin-bottom: 2rem; }
    .platform-header { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; text-transform: capitalize; }
    .ats-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    .ats-table th { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 2px solid var(--pico-muted-border-color); color: var(--pico-muted-color); }
    .ats-table td { padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--pico-muted-border-color); }
    .ats-table tr:last-child td { border-bottom: none; }
    .url-cell { word-break: break-all; max-width: 300px; }
    .source-badge { font-size: 0.7rem; padding: 0.1rem 0.35rem; border-radius: 3px; background: var(--pico-muted-border-color); }
  </style>
</head>
<body>
<main class="container">
  <h1>ATS Blocked (<%= total %>)</h1>

  <nav class="nav-bar">
    <a href="/" role="button" class="outline">Job Postings</a>
    <a href="/pending-review" role="button" class="outline">Pending Review</a>
    <a href="/ats-blocked" role="button" class="outline contrast">ATS Blocked</a>
    <a href="/scrape-status" role="button" class="outline">Scrape Status</a>
  </nav>

  <p style="color:var(--pico-muted-color); font-size:0.85rem;">
    These companies use third-party ATS platforms. They are permanently excluded from direct scraping.
    To rescue a company, run: <code>node scripts/export-ats-blocked.cjs --rescue "Company Name"</code>
  </p>

  <% Object.entries(grouped).sort((a,b) => b[1].length - a[1].length).forEach(([platform, companies]) => { %>
    <div class="platform-section">
      <p class="platform-header"><%= platform %> (<%= companies.length %>)</p>
      <table class="ats-table">
        <thead>
          <tr>
            <th>Company</th>
            <th>URL</th>
            <th>Flagged</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          <% companies.forEach(co => { %>
            <tr>
              <td><%= co.company_name %></td>
              <td class="url-cell">
                <a href="<%= co.careers_url %>" target="_blank" style="font-size:0.78rem;">
                  <%= co.careers_url ? co.careers_url.replace(/^https?:\/\//, '') : '—' %>
                </a>
              </td>
              <td><%= co.date_flagged ? new Date(co.date_flagged).toLocaleDateString() : '—' %></td>
              <td><span class="source-badge"><%= co.source %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>

</main>
</body>
</html>
