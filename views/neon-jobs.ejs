<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Career Future — Job Postings</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <style>
    .nav-bar { display: flex; gap: 8px; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center; }
    .nav-bar a { font-size: 0.85rem; padding: 0.4rem 0.8rem; }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
    .stat-card { background: var(--pico-card-background-color); border: 1px solid var(--pico-muted-border-color); border-radius: 8px; padding: 0.75rem 1rem; text-align: center; }
    .stat-card .num { font-size: 1.8rem; font-weight: 700; color: #4361ee; line-height: 1; }
    .stat-card .lbl { font-size: 0.75rem; color: var(--pico-muted-color); margin-top: 0.25rem; }
    .filter-bar { display: flex; gap: 8px; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .filter-bar select, .filter-bar input { margin: 0; padding: 0.4rem 0.6rem; font-size: 0.85rem; }
    .job-card { margin-bottom: 0.75rem; padding: 0.9rem 1rem; border: 1px solid var(--pico-muted-border-color); border-radius: 8px; }
    .job-card.applied { border-left: 4px solid #2ecc71; opacity: 0.75; }
    .job-card h4 { margin: 0 0 0.3rem; font-size: 1rem; }
    .job-meta { font-size: 0.82rem; color: var(--pico-muted-color); margin: 0.2rem 0; }
    .job-actions { display: flex; gap: 8px; margin-top: 0.6rem; flex-wrap: wrap; }
    .job-actions a, .job-actions button { font-size: 0.8rem; padding: 0.3rem 0.7rem; margin: 0; }
    .badge { display: inline-block; font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 600; }
    .badge-yes { background: #d4edda; color: #155724; }
    .badge-no  { background: #f8d7da; color: #721c24; }
    .badge-applied { background: #cce5ff; color: #004085; }
    .badge-strong   { background: #d4edda; color: #155724; }
    .badge-possible { background: #fff3cd; color: #856404; }
    .badge-weak     { background: #f8d7da; color: #721c24; }
    .match-reasoning { font-size: 0.8rem; margin: 0.3rem 0; }
    .skill-chips { display: flex; flex-wrap: wrap; gap: 4px; margin: 0.3rem 0; }
    .skill-chip { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: var(--pico-code-background-color); }
    .skill-chip.missing { text-decoration: line-through; opacity: 0.7; }
    .source-tag { font-size: 0.72rem; color: var(--pico-muted-color); }
    .run-bar { display: flex; gap: 8px; align-items: center; margin-bottom: 1rem; }
    #scraper-status { font-size: 0.85rem; color: var(--pico-muted-color); }
  </style>
</head>
<body>
<main class="container">
  <h1>Career Future — Job Postings</h1>

  <nav class="nav-bar">
    <a href="/" role="button" class="outline contrast">Job Postings</a>
    <a href="/pending-review" role="button" class="outline">Pending Review</a>
    <a href="/ats-blocked" role="button" class="outline">ATS Blocked</a>
    <a href="/scrape-status" role="button" class="outline">Scrape Status</a>
  </nav>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="num"><%= counts.yes_30d %></div>
      <div class="lbl">Relevant (30d)</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= counts.yes_7d %></div>
      <div class="lbl">Relevant (7d)</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= counts.applied %></div>
      <div class="lbl">Applied</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= counts.strong_matches %></div>
      <div class="lbl">Strong Matches</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= counts.total %></div>
      <div class="lbl">Total Seen</div>
    </div>
  </div>

  <div class="run-bar">
    <button id="run-btn" class="outline" onclick="runScraper()">Run Scraper Now</button>
    <span id="scraper-status"><%= scraperRunning ? '⏳ Scraper running...' : '' %></span>
    <button id="match-btn" class="outline" onclick="runMatcher()">Run Matcher Now</button>
    <span id="matcher-status"><%= matcherRunning ? '⏳ Matcher running...' : '' %></span>
  </div>

  <div class="filter-bar">
    <label>
      Show
      <select id="filter-select" onchange="applyFilters()">
        <option value="yes"     <%= filter === 'yes'     ? 'selected' : '' %>>Relevant only</option>
        <option value="all"     <%= filter === 'all'     ? 'selected' : '' %>>All jobs</option>
        <option value="applied" <%= filter === 'applied' ? 'selected' : '' %>>Applied</option>
      </select>
    </label>
    <label>
      Source
      <select id="source-select" onchange="applyFilters()">
        <option value="all"           <%= source === 'all'           ? 'selected' : '' %>>All sources</option>
        <option value="curated"       <%= source === 'curated'       ? 'selected' : '' %>>Curated</option>
        <option value="weekly"        <%= source === 'weekly'        ? 'selected' : '' %>>Weekly</option>
        <option value="legacy_daily"  <%= source === 'legacy_daily'  ? 'selected' : '' %>>Legacy: Daily boards</option>
        <option value="legacy_weekly" <%= source === 'legacy_weekly' ? 'selected' : '' %>>Legacy: Weekly</option>
        <option value="legacy_dorks"  <%= source === 'legacy_dorks'  ? 'selected' : '' %>>Legacy: Dorks</option>
        <option value="claude_search" <%= source === 'claude_search' ? 'selected' : '' %>>Claude Agent</option>
      </select>
    </label>
    <label>
      Days
      <select id="days-select" onchange="applyFilters()">
        <option value="7"  <%= days === 7  ? 'selected' : '' %>>Last 7 days</option>
        <option value="30" <%= days === 30 ? 'selected' : '' %>>Last 30 days</option>
        <option value="90" <%= days === 90 ? 'selected' : '' %>>Last 90 days</option>
      </select>
    </label>
    <label>
      Sort
      <select id="sort-select" onchange="applyFilters()">
        <option value="triage" <%= sort === 'triage' ? 'selected' : '' %>>Triage / Date</option>
        <option value="match"  <%= sort === 'match'  ? 'selected' : '' %>>Match Score</option>
      </select>
    </label>
    <input type="search" id="title-search" placeholder="Filter by title..." oninput="filterCards()" style="flex:1; min-width:160px;">
  </div>

  <p style="color: var(--pico-muted-color); font-size: 0.85rem;">
    Showing <%= jobs.length %> job<%= jobs.length !== 1 ? 's' : '' %>
  </p>

  <% if (jobs.length === 0) { %>
    <p>No jobs found for the current filters. Try expanding the date range or running the scraper.</p>
  <% } %>

  <div id="job-list">
    <% jobs.forEach(job => { %>
      <article class="job-card<%= job.applied ? ' applied' : '' %>"
               data-title="<%= job.job_title.toLowerCase() %>"
               id="job-<%= job.id %>">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:4px;">
          <h4><%= job.job_title %></h4>
          <div style="display:flex; gap:4px; flex-wrap:wrap;">
            <span class="badge badge-<%= job.triage_result %>"><%= job.triage_result.toUpperCase() %></span>
            <% if (job.match_score !== null) { %>
              <span class="badge badge-<%= job.match_tier %>"><%= job.match_score %> match</span>
            <% } %>
            <% if (job.applied) { %><span class="badge badge-applied">APPLIED</span><% } %>
            <span class="source-tag"><%= job.source %></span>
          </div>
        </div>
        <p class="job-meta"><strong><%= job.company_name %></strong> — <%= job.location %></p>
        <p class="job-meta" style="font-size:0.78rem;"><%= job.triage_reason %></p>
        <% if (job.match_reasoning) { %>
          <p class="match-reasoning"><%= job.match_reasoning %></p>
          <div class="skill-chips">
            <% (job.match_skills_matched || '').split(',').filter(s => s.trim()).forEach(s => { %>
              <span class="skill-chip"><%= s.trim() %></span>
            <% }) %>
            <% (job.match_skills_missing || '').split(',').filter(s => s.trim()).forEach(s => { %>
              <span class="skill-chip missing"><%= s.trim() %></span>
            <% }) %>
          </div>
        <% } %>
        <p class="job-meta">First seen: <%= new Date(job.first_seen).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
        <div class="job-actions">
          <% if (job.job_url) { %>
            <a href="<%= job.job_url %>" target="_blank" role="button">View Job ↗</a>
          <% } %>
          <button class="outline secondary" onclick="toggleApplied(<%= job.id %>, this)">
            <%= job.applied ? 'Unmark Applied' : 'Mark Applied' %>
          </button>
        </div>
      </article>
    <% }) %>
  </div>

</main>

<script>
function applyFilters() {
  const p = new URLSearchParams();
  p.set('filter', document.getElementById('filter-select').value);
  p.set('source', document.getElementById('source-select').value);
  p.set('days',   document.getElementById('days-select').value);
  p.set('sort',   document.getElementById('sort-select').value);
  window.location.href = '/?' + p.toString();
}

function filterCards() {
  const q = document.getElementById('title-search').value.toLowerCase().trim();
  document.querySelectorAll('.job-card').forEach(card => {
    card.style.display = !q || card.dataset.title.includes(q) ? '' : 'none';
  });
}

async function toggleApplied(id, btn) {
  const res  = await fetch(`/api/mark-applied/${id}`, { method: 'POST' });
  const data = await res.json();
  if (data.ok) {
    const card = document.getElementById(`job-${id}`);
    card.classList.toggle('applied', data.applied);
    btn.textContent = data.applied ? 'Unmark Applied' : 'Mark Applied';
  }
}

async function runScraper() {
  const btn    = document.getElementById('run-btn');
  const status = document.getElementById('scraper-status');
  btn.setAttribute('disabled', true);
  btn.setAttribute('aria-busy', 'true');
  status.textContent = '⏳ Starting scraper...';

  try {
    const res  = await fetch('/api/run-scraper', { method: 'POST' });
    const data = await res.json();
    if (res.ok) {
      status.textContent = '⏳ Scraper running — results will appear after completion';
    } else {
      status.textContent = '⚠️ ' + (data.error || 'Could not start scraper');
      btn.removeAttribute('disabled');
      btn.removeAttribute('aria-busy');
    }
  } catch (err) {
    status.textContent = '⚠️ Failed to start scraper';
    btn.removeAttribute('disabled');
    btn.removeAttribute('aria-busy');
  }
}

async function runMatcher() {
  const btn    = document.getElementById('match-btn');
  const status = document.getElementById('matcher-status');
  btn.setAttribute('disabled', true);
  btn.setAttribute('aria-busy', 'true');
  status.textContent = '⏳ Starting matcher...';

  try {
    const res  = await fetch('/api/run-matcher', { method: 'POST' });
    const data = await res.json();
    if (res.ok) {
      status.textContent = '⏳ Matcher running — results will appear after completion';
    } else {
      status.textContent = '⚠️ ' + (data.error || 'Could not start matcher');
      btn.removeAttribute('disabled');
      btn.removeAttribute('aria-busy');
    }
  } catch (err) {
    status.textContent = '⚠️ Failed to start matcher';
    btn.removeAttribute('disabled');
    btn.removeAttribute('aria-busy');
  }
}

// Poll scraper status on load if running
<% if (scraperRunning) { %>
const scraperPoll = setInterval(async () => {
  const s = await fetch('/api/scraper-status').then(r => r.json());
  if (!s.running) {
    clearInterval(scraperPoll);
    window.location.reload();
  }
}, 5000);
<% } %>

// Poll matcher status on load if running
<% if (matcherRunning) { %>
const matcherPoll = setInterval(async () => {
  const s = await fetch('/api/matcher-status').then(r => r.json());
  if (!s.running) {
    clearInterval(matcherPoll);
    window.location.reload();
  }
}, 5000);
<% } %>
</script>
</body>
</html>
