<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Career Future - Job Dashboard</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="/css/resume_optimizer_styles.css">
    <style>
        .tab-bar { display: flex; align-items: center; border-bottom: 2px solid var(--pico-muted-border-color); margin-bottom: 1rem; }
        .tab-btn { padding: 0.6rem 1.2rem; cursor: pointer; font-size: 1rem; color: #7b8495; border-bottom: 3px solid transparent; margin-bottom: -2px; user-select: none; }
        .tab-btn.active { color: #4361ee; border-bottom-color: #4361ee; font-weight: 600; }
        .tab-btn:hover:not(.active) { color: #c2c7d0; }
        .action-btns { display: flex; gap: 8px; margin-bottom: 1rem; }
        .action-btns a, .action-btns button { flex: 1; font-size: 0.85rem; padding: 0.45rem 0.75rem; text-align: center; }
        .action-btns .btn-spacer { flex: 0 0 1px; width: 1px; padding: 0; margin: 0 4px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        #log-panel { display: none; margin-bottom: 1rem; }
        #log-panel.visible { display: block; }
        #log-output {
            background: var(--pico-card-background-color, #1a1a2e);
            color: var(--pico-color, #c8c8d0);
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 0.8rem;
            line-height: 1.4;
            padding: 0.75rem;
            border-radius: 6px;
            max-height: 300px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border: 1px solid var(--pico-muted-border-color);
        }
        #log-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
        #log-header small { color: var(--pico-muted-color); }
        .tab-stats { background: var(--pico-card-background-color); border: 1px solid var(--pico-muted-border-color); border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; }
        .tab-stats .grid { margin-bottom: 0; }
        .tab-stats strong { font-size: 0.9rem; }
    </style>
</head>
<body>
    <main class="container">
        <h1>Career Future!<%= headerSearchValue ? ' - ' + headerSearchValue : '' %></h1>

        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin-bottom: 1rem;">
            <label>
                Time Range
                <select id="time-range">
                    <option value="24h"<%= range === '24h' ? ' selected' : '' %>>Last 24 Hours</option>
                    <option value="7d"<%= range === '7d' ? ' selected' : '' %>>Last 7 Days</option>
                    <option value="30d"<%= range === '30d' ? ' selected' : '' %>>Last 30 Days</option>
                    <option value="all"<%= range === 'all' ? ' selected' : '' %>>All Time</option>
                </select>
            </label>
            <label>
                Field
                <select id="search-field">
                    <option value="title">Title</option>
                    <option value="company">Company</option>
                    <option value="location">Location</option>
                </select>
            </label>
            <label>
                Match
                <select id="search-modifier">
                    <option value="contains">Contains</option>
                    <option value="exact">Exact Match</option>
                    <option value="begins">Begins With</option>
                    <option value="ends">Ends With</option>
                </select>
            </label>
            <label style="flex: 1;">
                Search
                <input type="search" id="search-value" placeholder="Type to filter...">
            </label>
            <button id="search-clear" class="outline secondary">Clear</button>
        </div>

        <div class="action-btns">
            <a href="/companies" role="button" class="outline">Daily Companies</a>
            <a href="/companies-weekly" role="button" class="outline">Weekly Companies</a>
            <a href="/ats-list" role="button" class="outline">ATS Firms</a>
            <div class="btn-spacer"></div>
            <a href="/settings" role="button" class="outline">Settings</a>
            <button id="analyze-external-job-btn" class="contrast outline">Analyze External Job</button>
        </div>
        <hr>

        <div id="log-panel">
            <div id="log-header">
                <small>Live Output</small>
                <button id="log-toggle-btn" class="outline secondary" style="padding: 0.2rem 0.6rem; font-size: 0.75rem;">Hide</button>
            </div>
            <div id="log-output"></div>
        </div>

        <div class="tab-bar">
            <span class="tab-btn<%= defaultTab === 'daily' ? ' active' : '' %>" data-tab="daily">Daily Results (<%= dailyJobs.length %>)</span>
            <span class="tab-btn<%= defaultTab === 'weekly' ? ' active' : '' %>" data-tab="weekly">Weekly Results (<%= weeklyJobs.length %>)</span>
            <span class="tab-btn<%= defaultTab === 'ats' ? ' active' : '' %>" data-tab="ats">Applicant Tracking (<%= dorkJobs.length %>)</span>
        </div>

        <%# ==================== DAILY RESULTS TAB ==================== %>
        <div id="tab-daily" class="tab-content<%= defaultTab === 'daily' ? ' active' : '' %>">
            <div class="tab-stats">
                <div class="grid">
                    <div><strong>Companies Enabled:</strong> <%= tabStats.daily.companiesEnabled %></div>
                    <div><strong>Companies Disabled:</strong> <%= tabStats.daily.companiesDisabled %></div>
                    <div><strong>Jobs (<%= range %>):</strong> <%= tabStats.daily.jobCount %></div>
                    <div><strong>Last Run:</strong>
                        <% if (tabStats.daily.lastRun && tabStats.daily.lastRun.timestamp) { %>
                            <%= new Date(tabStats.daily.lastRun.timestamp).toLocaleDateString() %> at <%= new Date(tabStats.daily.lastRun.timestamp).toLocaleTimeString() %>
                        <% } else { %>
                            Never
                        <% } %>
                    </div>
                    <div><strong>Search Value:</strong> <%= (tabStats.daily.lastRun && tabStats.daily.lastRun.searchValue) ? tabStats.daily.lastRun.searchValue : 'Title, Location or Company' %></div>
                </div>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem;">
                <button id="run-daily-btn" class="outline">Run Daily Companies Now</button>
                <button class="stop-btn outline secondary" style="display:none;">Stop</button>
                <span class="scraper-status" style="align-self: center;"></span>
            </div>
            <p class="search-results-count" id="search-results-count-daily" style="display:none;"></p>
            <% if (dailyJobs.length === 0) { %>
                <p>No jobs found yet. Run a search to start finding jobs!</p>
            <% } else { %>
                <% dailyJobs.forEach(job => { %>
                    <article class="job-card" data-url="<%= job.url %>"
                             data-title="<%= job.title %>"
                             data-company="<%= job.company %>"
                             data-location="<%= job.location || '' %>">
                        <h3 class="job-title"><%= job.title %></h3>
                        <p class="job-company"><strong><%= job.company %></strong></p>
                        <p class="job-location"><%= job.location || 'Location not specified' %></p>
                        <p>Found: <%= new Date(job.firstSeen).toLocaleDateString() %></p>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <a href="<%= job.url %>" target="_blank" role="button">View Job</a>
                            <button class="btn-optimize-resume" type="button">Optimize Resume</button>
                        </div>
                    </article>
                <% }); %>
            <% } %>
        </div>

        <%# ==================== WEEKLY RESULTS TAB ==================== %>
        <div id="tab-weekly" class="tab-content<%= defaultTab === 'weekly' ? ' active' : '' %>">
            <div class="tab-stats">
                <div class="grid">
                    <div><strong>Companies Enabled:</strong> <%= tabStats.weekly.companiesEnabled %></div>
                    <div><strong>Companies Disabled:</strong> <%= tabStats.weekly.companiesDisabled %></div>
                    <div><strong>Jobs (<%= range %>):</strong> <%= tabStats.weekly.jobCount %></div>
                    <div><strong>Last Run:</strong>
                        <% if (tabStats.weekly.lastRun && tabStats.weekly.lastRun.timestamp) { %>
                            <%= new Date(tabStats.weekly.lastRun.timestamp).toLocaleDateString() %> at <%= new Date(tabStats.weekly.lastRun.timestamp).toLocaleTimeString() %>
                        <% } else { %>
                            Never
                        <% } %>
                    </div>
                    <div><strong>Search Value:</strong> <%= (tabStats.weekly.lastRun && tabStats.weekly.lastRun.searchValue) ? tabStats.weekly.lastRun.searchValue : 'Title, Location or Company' %></div>
                </div>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem;">
                <button id="run-weekly-btn" class="outline">Run Weekly Companies Now</button>
                <button class="stop-btn outline secondary" style="display:none;">Stop</button>
                <span class="scraper-status" style="align-self: center;"></span>
            </div>
            <p class="search-results-count" id="search-results-count-weekly" style="display:none;"></p>
            <% if (weeklyJobs.length === 0) { %>
                <p>No weekly jobs found yet. Run a weekly search to start finding jobs!</p>
            <% } else { %>
                <% weeklyJobs.forEach(job => { %>
                    <article class="job-card" data-url="<%= job.url %>"
                             data-title="<%= job.title %>"
                             data-company="<%= job.company %>"
                             data-location="<%= job.location || '' %>">
                        <h3 class="job-title"><%= job.title %></h3>
                        <p class="job-company"><strong><%= job.company %></strong></p>
                        <p class="job-location"><%= job.location || 'Location not specified' %></p>
                        <p>Found: <%= new Date(job.firstSeen).toLocaleDateString() %></p>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <a href="<%= job.url %>" target="_blank" role="button">View Job</a>
                            <button class="btn-optimize-resume" type="button">Optimize Resume</button>
                        </div>
                    </article>
                <% }); %>
            <% } %>
        </div>

        <%# ==================== APPLICANT TRACKING TAB ==================== %>
        <div id="tab-ats" class="tab-content<%= defaultTab === 'ats' ? ' active' : '' %>">
            <div class="tab-stats">
                <div class="grid">
                    <div><strong>ATS Queries:</strong> <%= tabStats.ats.queriesCount %></div>
                    <div><strong>Jobs (<%= range %>):</strong> <%= tabStats.ats.jobCount %></div>
                    <div><strong>Last Run:</strong>
                        <% if (tabStats.ats.lastRun && tabStats.ats.lastRun.timestamp) { %>
                            <%= new Date(tabStats.ats.lastRun.timestamp).toLocaleDateString() %> at <%= new Date(tabStats.ats.lastRun.timestamp).toLocaleTimeString() %>
                        <% } else { %>
                            Never
                        <% } %>
                    </div>
                    <div><strong>Search Value:</strong> <%= (tabStats.ats.lastRun && tabStats.ats.lastRun.searchValue) ? tabStats.ats.lastRun.searchValue : 'Title, Location or Company' %></div>
                </div>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem;">
                <button id="run-dorks-btn" class="outline">Run Applicant Tracking Now</button>
                <button class="stop-btn outline secondary" style="display:none;">Stop</button>
                <span class="scraper-status" style="align-self: center;"></span>
            </div>
            <p class="search-results-count" id="search-results-count-ats" style="display:none;"></p>
            <% if (dorkJobs.length === 0) { %>
                <p>No applicant tracking jobs found yet. Click "Run Applicant Tracking Now" to search ATS platforms!</p>
            <% } else { %>
                <% dorkJobs.forEach(job => { %>
                    <article class="job-card" data-url="<%= job.url %>"
                             data-title="<%= job.title %>"
                             data-company="<%= job.company %>"
                             data-location="<%= job.location || '' %>">
                        <h3 class="job-title"><%= job.title %></h3>
                        <p class="job-company"><strong><%= job.company %></strong></p>
                        <p class="job-location"><%= job.location || 'Location not specified' %></p>
                        <p>Found: <%= new Date(job.firstSeen).toLocaleDateString() %></p>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <a href="<%= job.url %>" target="_blank" role="button">View Job</a>
                            <button class="btn-optimize-resume" type="button">Optimize Resume</button>
                        </div>
                    </article>
                <% }); %>
            <% } %>
        </div>
    </main>
    <script>
    (function() {
      const field = document.getElementById('search-field');
      const modifier = document.getElementById('search-modifier');
      const value = document.getElementById('search-value');
      const clearBtn = document.getElementById('search-clear');

      // Tab switching — three tabs
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = {
        daily: document.getElementById('tab-daily'),
        weekly: document.getElementById('tab-weekly'),
        ats: document.getElementById('tab-ats')
      };

      let activeTab = '<%= defaultTab %>';

      function switchTab(tab) {
        activeTab = tab;
        tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
        Object.entries(tabContents).forEach(([k, el]) => el.classList.toggle('active', k === tab));

        // Update URL
        const p = new URLSearchParams(window.location.search);
        if (tab === 'daily') p.delete('tab'); else p.set('tab', tab);
        history.replaceState(null, '', '/?' + p.toString());

        // Re-apply filter to new tab
        applyFilter();
      }

      tabBtns.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

      // Restore tab from URL (overrides server default)
      const params = new URLSearchParams(window.location.search);
      const urlTab = params.get('tab');
      if (urlTab && tabContents[urlTab]) switchTab(urlTab);

      function getActiveCards() {
        const container = tabContents[activeTab];
        return container.querySelectorAll('.job-card');
      }

      function getActiveCountEl() {
        return document.getElementById('search-results-count-' + activeTab);
      }

      function applyFilter() {
        const searchVal = value.value.toLowerCase().trim();
        const cards = getActiveCards();
        const countEl = getActiveCountEl();

        // Hide all other tabs' count elements
        document.querySelectorAll('.search-results-count').forEach(el => el.style.display = 'none');

        if (!searchVal) {
          cards.forEach(c => c.style.display = '');
          if (countEl) countEl.style.display = 'none';
          return;
        }

        let shown = 0;
        cards.forEach(card => {
          const fieldVal = (card.dataset[field.value] || '').toLowerCase();
          let match = false;

          switch (modifier.value) {
            case 'exact':    match = fieldVal === searchVal; break;
            case 'contains': match = fieldVal.includes(searchVal); break;
            case 'begins':   match = fieldVal.startsWith(searchVal); break;
            case 'ends':     match = fieldVal.endsWith(searchVal); break;
          }

          card.style.display = match ? '' : 'none';
          if (match) shown++;
        });

        if (countEl) {
          countEl.textContent = `Showing ${shown} of ${cards.length} jobs`;
          countEl.style.display = '';
        }
      }

      // Restore search state from URL params on page load
      if (params.get('field')) field.value = params.get('field');
      if (params.get('modifier')) modifier.value = params.get('modifier');
      if (params.get('search')) { value.value = params.get('search'); applyFilter(); }

      value.addEventListener('input', applyFilter);
      field.addEventListener('change', applyFilter);
      modifier.addEventListener('change', applyFilter);
      clearBtn.addEventListener('click', () => {
        value.value = '';
        applyFilter();
      });

      // Time range dropdown
      const timeRange = document.getElementById('time-range');
      timeRange.addEventListener('change', () => {
        const p = new URLSearchParams(window.location.search);
        p.set('range', timeRange.value);
        window.location.href = '/?' + p.toString();
      });

      // Scraper run buttons (per-tab)
      const dailyBtn = document.getElementById('run-daily-btn');
      const weeklyBtn = document.getElementById('run-weekly-btn');
      const dorksBtn = document.getElementById('run-dorks-btn');

      // Track which type of search is running so Stop knows what to call
      let activeSearchType = null; // 'scraper' or 'dorks'
      let activePoll = null;
      let activeRunBtn = null;
      let activeStopBtn = null;
      let activeStatusEl = null;

      function searchParams() {
        const p = new URLSearchParams();
        p.set('range', timeRange.value);
        if (activeTab !== 'daily') p.set('tab', activeTab);
        if (field.value) p.set('field', field.value);
        if (modifier.value) p.set('modifier', modifier.value);
        if (value.value.trim()) p.set('search', value.value.trim());
        return p.toString();
      }

      function setRunningState(btn, stopBtn, statusEl, label) {
        activeRunBtn = btn;
        activeStopBtn = stopBtn;
        activeStatusEl = statusEl;
        btn.setAttribute('disabled', true);
        btn.setAttribute('aria-busy', 'true');
        statusEl.textContent = label;
        stopBtn.style.display = '';
      }

      function clearRunningState() {
        if (activePoll) { clearInterval(activePoll); activePoll = null; }
        if (activeRunBtn) {
          activeRunBtn.removeAttribute('disabled');
          activeRunBtn.removeAttribute('aria-busy');
          activeRunBtn = null;
        }
        if (activeStopBtn) {
          activeStopBtn.style.display = 'none';
          activeStopBtn = null;
        }
        if (activeStatusEl) {
          activeStatusEl = null;
        }
        activeSearchType = null;
      }

      function getTabControls(tabKey) {
        const container = tabContents[tabKey];
        return {
          stopBtn: container.querySelector('.stop-btn'),
          statusEl: container.querySelector('.scraper-status')
        };
      }

      async function runScraper(mode, btn) {
        if (activeSearchType) return;

        // Warn if search field is empty
        if (!value.value.trim()) {
          if (!confirm('The Search field is empty. The job will use the default keywords from Settings.\n\nDo you want to continue?')) {
            return;
          }
        }

        activeSearchType = 'scraper';
        const tabKey = mode === 'weekly' ? 'weekly' : 'daily';
        const { stopBtn, statusEl } = getTabControls(tabKey);
        setRunningState(btn, stopBtn, statusEl, `Running ${mode} search...`);

        try {
          const res = await fetch('/api/run-scraper', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode, searchValue: value.value.trim(), matchMode: modifier.value })
          });
          const data = await res.json();

          if (!res.ok) {
            statusEl.textContent = data.error || 'Error starting search';
            clearRunningState();
            return;
          }

          activePoll = setInterval(async () => {
            const s = await fetch('/api/scraper-status').then(r => r.json());
            if (!s.running) {
              clearRunningState();
              // Redirect preserving current tab
              const p = new URLSearchParams(window.location.search);
              p.set('tab', tabKey);
              p.set('range', timeRange.value);
              window.location.href = '/?' + p.toString();
            }
          }, 3000);
        } catch (err) {
          statusEl.textContent = 'Failed to start search';
          clearRunningState();
        }
      }

      async function runDorks() {
        if (activeSearchType) return;

        // Warn if search field is empty
        if (!value.value.trim()) {
          if (!confirm('The Search field is empty. The job will use the default keywords from Settings.\n\nDo you want to continue?')) {
            return;
          }
        }

        activeSearchType = 'dorks';
        const { stopBtn, statusEl } = getTabControls('ats');
        setRunningState(dorksBtn, stopBtn, statusEl, 'Running Applicant Tracking search...');

        try {
          const res = await fetch('/api/run-dorks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ searchValue: value.value.trim(), matchMode: modifier.value })
          });
          const data = await res.json();

          if (!res.ok) {
            statusEl.textContent = data.error || 'Error starting search';
            clearRunningState();
            return;
          }

          activePoll = setInterval(async () => {
            const s = await fetch('/api/dork-status').then(r => r.json());
            if (!s.running) {
              clearRunningState();
              const p = new URLSearchParams(window.location.search);
              p.set('tab', 'ats');
              p.set('range', timeRange.value);
              window.location.href = '/?' + p.toString();
            }
          }, 3000);
        } catch (err) {
          statusEl.textContent = 'Failed to start search';
          clearRunningState();
        }
      }

      async function stopSearch() {
        const endpoint = activeSearchType === 'dorks' ? '/api/stop-dorks' : '/api/stop-scraper';
        if (activeStopBtn) {
          activeStopBtn.setAttribute('disabled', true);
          activeStopBtn.setAttribute('aria-busy', 'true');
        }

        try {
          await fetch(endpoint, { method: 'POST' });
          if (activeStatusEl) activeStatusEl.textContent = 'Search stopped';
        } catch {
          if (activeStatusEl) activeStatusEl.textContent = 'Failed to stop search';
        }
        clearRunningState();
      }

      dailyBtn.addEventListener('click', () => runScraper('daily', dailyBtn));
      weeklyBtn.addEventListener('click', () => runScraper('weekly', weeklyBtn));
      dorksBtn.addEventListener('click', runDorks);

      // All stop buttons delegate to the same handler
      document.querySelectorAll('.stop-btn').forEach(btn => {
        btn.addEventListener('click', stopSearch);
      });

      // --- Live log panel ---
      const logPanel = document.getElementById('log-panel');
      const logOutput = document.getElementById('log-output');
      const logToggleBtn = document.getElementById('log-toggle-btn');
      let logVisible = true;
      let eventSource = null;

      logToggleBtn.addEventListener('click', () => {
        logVisible = !logVisible;
        logOutput.style.display = logVisible ? '' : 'none';
        logToggleBtn.textContent = logVisible ? 'Hide' : 'Show';
      });

      function showLogPanel() {
        logPanel.classList.add('visible');
        logOutput.textContent = '';
      }

      function connectLogStream() {
        if (eventSource) return;
        eventSource = new EventSource('/api/logs/stream');
        eventSource.onmessage = (e) => {
          try {
            const entry = JSON.parse(e.data);
            logOutput.textContent += entry.text + '\n';
            logOutput.scrollTop = logOutput.scrollHeight;
          } catch { /* ignore parse errors */ }
        };
        eventSource.onerror = () => {
          // Reconnect handled automatically by EventSource
        };
      }

      function disconnectLogStream() {
        if (eventSource) {
          eventSource.close();
          eventSource = null;
        }
      }

      // Patch setRunningState / clearRunningState to manage log stream
      const origSetRunning = setRunningState;
      setRunningState = function(btn, stopBtn, statusEl, label) {
        origSetRunning(btn, stopBtn, statusEl, label);
        showLogPanel();
        connectLogStream();
      };

      const origClearRunning = clearRunningState;
      clearRunningState = function() {
        origClearRunning();
        // Brief delay so final log lines arrive before disconnect
        setTimeout(disconnectLogStream, 2000);
      };
    })();
    </script>
    <script src="/js/public_resume_optimizer.js"></script>
</body>
</html>
