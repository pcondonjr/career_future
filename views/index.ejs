<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Salesforce Job Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
    <main class="container">
        <h1>🎯 Salesforce Job Dashboard</h1>
        <div class="grid">
            <div><strong>Total Jobs:</strong> <%= stats.total %></div>
            <div><strong>Last 24h:</strong> <%= stats.last24Hours %></div>
            <div><strong>This Week:</strong> <%= stats.lastWeek %></div>
            <div><strong>Companies:</strong> <%= totalCompanies %></div>
        </div>
        <hr>
        <div class="grid">
            <button onclick="location.href='/api/export'">📥 Export CSV</button>
            <button onclick="location.href='/companies'">⚙️ Manage Companies</button>
        </div>
        <hr>
        <% if (jobs.length === 0) { %>
            <p>No jobs found yet. Run the scraper to start finding jobs!</p>
        <% } else { %>
            <% jobs.forEach(job => { %>
                <article>
                    <h3><%= job.title %></h3>
                    <p><strong><%= job.company %></strong></p>
                    <p>📍 <%= job.location || 'Location not specified' %></p>
                    <p>📅 Found: <%= new Date(job.firstSeen).toLocaleDateString() %></p>
                    <a href="<%= job.url %>" target="_blank" role="button">View Job →</a>
                </article>
            <% }); %>
        <% } %>
    </main>
</body>
</html>
