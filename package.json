{
  "name": "career-future",
  "version": "1.0.0",
  "description": "Career Future - Automated job search assistant for career-focused professionals",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "legacy:start": "node index.js",
    "dashboard": "node dashboard.js",
    "test": "node index.js --now",
    "test:weekly": "node index.js --now --weekly",
    "validate": "node index.js --validate",
    "validate:weekly": "node index.js --validate --weekly",
    "test:dorks": "node index.js --now --dorks",
    "test:dorks-weekly": "node index.js --now --dorks --weekly",
    "add-company": "node add-company.js",
    "export": "node export-jobs.js",
    "enrich": "node scripts/enrich-companies.js",
    "enrich:stats": "node scripts/enrich-companies.js --stats",
    "neon:scheduler": "node src/backend/neon-scheduler.cjs",
    "neon:run": "node src/backend/neon-scheduler.cjs --now",
    "neon:dashboard": "node neon-dashboard-server.cjs",
    "neon:match": "node src/backend/match-harness.cjs",
    "neon:match:dry": "node src/backend/match-harness.cjs --dry-run --batch 5",
    "neon:import-legacy": "node scripts/import-legacy-jobs.cjs"
  },
  "keywords": [
    "career",
    "job-search",
    "job-scraper",
    "puppeteer",
    "automation",
    "electron",
    "desktop-app"
  ],
  "author": "Patrick Condon",
  "license": "MIT",
  "productName": "Career Future",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@mendable/firecrawl-js": "^4.17.0",
    "apify-client": "^2.22.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.0",
    "electron-store": "^11.0.2",
    "express": "^4.18.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "puppeteer-core": "^24.37.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.1.0"
  },
  "type": "module"
}
